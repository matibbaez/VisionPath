---
import { getLangFromUrl } from '../utils/i18n';

const lang = getLangFromUrl(Astro.url);

const sectionLabel = lang === 'en' ? "CASE STUDIES" : "CASOS DE ÉXITO";
const title1 = lang === 'en' ? "Engineering that" : "Ingeniería que";
const title2 = lang === 'en' ? "transforms businesses." : "transforma negocios.";
const btnText = lang === 'en' ? "View Case" : "Ver Caso";

// 1. TUS 3 PROYECTOS PRINCIPALES DE VANGUARDIA
const vanguardProjects = [
  {
    id: "trust-alliance",
    title: "Trust Alliance",
    category: "Startup LegalTech",
    description: lang === 'es' 
        ? "La nueva generación de servicios legales. Integramos derecho, inteligencia artificial y automatización para transformar los procesos en experiencias ágiles, transparentes y trazables." 
        : "The new generation of legal services. We integrate law, artificial intelligence, and automation to transform processes into agile, transparent, and traceable experiences.",
    image: "/trust-final.png",
    link: `/${lang}/case/trust-alliance`,
    color: "from-blue-600/20",
    tags: ["LegalTech", "AI", "Automation"]
  },
  {
    id: "tulex",
    title: "TuLex",
    category: "Legal Cloud SaaS",
    description: lang === 'es' 
        ? "Sistema SaaS en la nube para la gestión inteligente de estudios jurídicos, control de expedientes y plazos en tiempo real." 
        : "Cloud SaaS system for intelligent law firm management, case tracking, and real-time deadlines.",
    image: "/lexd.png",
    link: `/${lang}/case/tulex`,
    color: "from-[--color-primary]/20",
    tags: ["SaaS", "Management", "Cloud"]
  },
  {
    id: "reclama-ya",
    title: "ReclamaYa & ReclamarYa",
    category: "LegalTech & Sindical",
    description: lang === 'es' 
        ? "Núcleo de automatización inteligente para reclamos, con despliegue general y una versión exclusiva para el sindicato ASIM." 
        : "Intelligent automation core for claims, featuring a general deployment and an exclusive version for the ASIM syndicate.",
    isSplit: true,
    images: ["/reclamaya-1.png", "/reclamarya-2.png"], // Imágenes partidas al medio
    link: `/${lang}/case/reclama-ya`,
    color: "from-orange-600/20",
    tags: ["Automation", "LegalTech", "ASIM"]
  }
];

// 2. PLATAFORMAS EN PRODUCCIÓN
const productionProjects = [
  { 
    name: "M-GEO Abogados & Sports", 
    category: lang === 'es' ? "Asesoramiento jurídico integral y representación." : "Comprehensive legal advice and sports representation.", 
    image: "/m-geo.png", 
    link: "https://www.m-geo.ar/",
    tags: ["Sports", "Legal", "Corporate"]
  },
  { 
    name: "SP Abogados", 
    category: lang === 'es' ? "El compromiso que exige tu caso." : "The commitment your case demands.", 
    image: "/sp-abogado.png", 
    link: "https://www.spabogado.com.ar/",
    tags: ["Civil", "Laboral", "Familia"]
  },
  { 
    name: "Estudio Sevilla", 
    category: lang === 'es' ? "La mejor indemnización para los pibes de las motos." : "Top compensation for motorcycle riders.", 
    image: "/estudio-sevilla.png", 
    link: "https://www.estudiosevilla.com.ar/",
    tags: ["Accidentes", "Indemnizaciones"]
  },
  { 
    name: "Reclamarte", 
    category: lang === 'es' ? "Sistema especializado de reclamos ART." : "Specialized Workers' Comp claims system.", 
    image: "/reclamarte.png", 
    link: "https://www.reclamarte.ar/",
    tags: ["ART", "LegalTech", "Automation"]
  }
];
---

<section id="proyectos" class="relative py-24 md:py-32 bg-black">
    <div class="max-w-7xl mx-auto px-6">
        
        <div class="mb-16 md:mb-24">
            <span class="text-[--color-primary] font-mono text-sm tracking-widest uppercase mb-4 block">
                /// {sectionLabel}
            </span>
            <h2 class="text-4xl md:text-6xl font-bold text-white tracking-tight">
                {title1} <br/>
                <span class="text-glow-pop">{title2}</span>
            </h2>
        </div>

        <div class="flex flex-col gap-8 md:gap-12 pb-12">
            {vanguardProjects.map((project) => (
                <article class="sticky top-24 md:top-32 min-h-[500px] w-full rounded-[2rem] bg-[#0A0A0A] border border-white/10 overflow-hidden shadow-2xl group flex flex-col md:grid md:grid-cols-2">
                    
                    <div class="relative z-20 p-6 md:p-12 flex flex-col justify-between order-2 md:order-1 h-full">
                        <div class={`absolute inset-0 bg-gradient-to-br ${project.color} opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none`}></div>

                        <div class="relative z-10">
                            <div class="flex items-center gap-3 mb-4 md:mb-6">
                                <span class="w-1.5 h-1.5 rounded-full bg-[--color-primary] animate-pulse"></span>
                                <span class="text-xs font-mono text-gray-500 tracking-wider uppercase group-hover:text-white/70 transition-colors">{project.category}</span>
                            </div>
                            
                            <h3 class="text-3xl md:text-5xl font-bold text-white leading-tight mb-4 tracking-tight">
                                {project.title}
                            </h3>
                             
                            <p class="text-gray-400 text-sm md:text-lg leading-relaxed max-w-md group-hover:text-gray-300 transition-colors">
                                {project.description}
                            </p>
                        </div>

                        <div class="relative z-10 mt-8 md:mt-0 pt-6 border-t border-white/5 md:border-0 flex flex-col items-start gap-6">
                            <div class="flex flex-wrap gap-2">
                                {project.tags.map(tag => (
                                    <span class="px-3 py-1 rounded-full border border-white/10 bg-white/5 text-xs font-medium text-gray-300 backdrop-blur-sm">
                                        {tag}
                                    </span>
                                ))}
                            </div>

                            <a href={project.link} class="group/btn inline-flex items-center gap-3 text-white text-sm font-bold tracking-wide uppercase border-b border-white/20 pb-1 hover:border-[--color-primary] hover:text-[--color-primary] transition-all">
                                {btnText}
                                <svg class="w-4 h-4 transition-transform group-hover/btn:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                            </a>
                        </div>
                    </div>
    
                    <div class="relative h-64 md:h-full w-full overflow-hidden order-1 md:order-2 border-b md:border-b-0 md:border-l border-white/5 bg-[#050505]">
                        
                        {project.isSplit ? (
                            <!-- PANTALLA PARTIDA 50/50 AL ESTILO ORIGINAL -->
                            <div class="absolute inset-0 flex z-0 w-full h-full">
                                <!-- Lado Izquierdo (ReclamaYa) -->
                                <div class="w-1/2 h-full relative overflow-hidden border-r border-white/10">
                                    <div class="absolute inset-0 bg-black/40 group-hover:bg-transparent transition-colors duration-700 z-10 pointer-events-none"></div>
                                    <img src={project.images[0]} alt="Reclama Ya" class="absolute inset-0 w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105 grayscale group-hover:grayscale-0" onerror="this.src='https://images.unsplash.com/photo-1497366216548-37526070297c?q=80&w=800&auto=format&fit=crop'"/>
                                </div>
                                
                                <!-- Lado Derecho (ReclamarYa) -->
                                <div class="w-1/2 h-full relative overflow-hidden">
                                    <div class="absolute inset-0 bg-black/40 group-hover:bg-transparent transition-colors duration-700 z-10 pointer-events-none"></div>
                                    <img src={project.images[1]} alt="Reclamar Ya" class="absolute inset-0 w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105 grayscale group-hover:grayscale-0" onerror="this.src='https://images.unsplash.com/photo-1497366216548-37526070297c?q=80&w=800&auto=format&fit=crop'"/>
                                </div>

                                <!-- Badge Divisor -->
                                <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-20 bg-[#0A0A0A]/90 backdrop-blur-md border border-white/10 px-3 py-1.5 rounded-full flex items-center shadow-2xl">
                                    <span class="text-[--color-primary] text-[9px] font-mono tracking-widest uppercase font-bold">Dual System</span>
                                </div>
                            </div>
                        ) : (
                            <!-- IMAGEN ÚNICA DE BORDE A BORDE -->
                            <div class="absolute inset-0 w-full h-full">
                                <div class="absolute inset-0 bg-black/40 group-hover:bg-transparent transition-colors duration-700 z-10 pointer-events-none"></div>
                                <img src={project.image} alt={project.title} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 grayscale group-hover:grayscale-0" onerror="this.src='https://images.unsplash.com/photo-1497366216548-37526070297c?q=80&w=800&auto=format&fit=crop'" />
                            </div>
                        )}
                    </div>
                </article>
            ))}
        </div>

        <div class="mt-8 pt-12 border-t border-white/10">
            <div class="mb-10 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <h3 class="text-xl md:text-2xl font-bold text-white tracking-tight">
                        {lang === 'en' ? "Live Production Platforms" : "Plataformas en Producción"}
                    </h3>
                    <p class="text-sm text-gray-500 font-light mt-1">
                        {lang === 'en' ? "Active high-end solutions powering leading firms." : "Soluciones integrales activas impulsando firmas líderes."}
                    </p>
                </div>
                <div class="text-xs font-mono text-gray-600 uppercase tracking-widest">
                    /// {lang === 'en' ? "VERIFIED DEPLOYMENTS" : "DESPLIEGUES VERIFICADOS"}
                </div>
            </div>

            <!-- Grilla 2 columnas con Thumbnails -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 md:gap-6">
                {productionProjects.map((p) => (
                    <a 
                        href={p.link} 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="group relative flex flex-col sm:flex-row items-center gap-5 p-4 md:p-5 rounded-2xl bg-[#0A0A0A] border border-white/5 hover:border-white/10 transition-all duration-500 overflow-hidden"
                    >
                        <div class="w-full sm:w-36 h-48 sm:h-28 rounded-xl overflow-hidden shrink-0 border border-white/5 relative bg-[#050505]">
                            <div class="absolute inset-0 bg-black/30 group-hover:bg-transparent transition-colors duration-500 z-10"></div>
                            <img 
                                src={p.image} 
                                alt={p.name} 
                                class="w-full h-full object-cover object-top grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700" 
                                onerror="this.src='https://images.unsplash.com/photo-1497366216548-37526070297c?q=80&w=800&auto=format&fit=crop'"
                            />
                        </div>

                        <div class="flex-1 w-full flex flex-col justify-center">
                            <div class="flex justify-between items-start mb-2">
                                <div>
                                    <h4 class="text-lg md:text-xl font-bold text-gray-200 group-hover:text-white transition-colors tracking-tight">
                                        {p.name}
                                    </h4>
                                    <p class="text-sm text-gray-500 font-light mt-1 max-w-[280px]">
                                        {p.category}
                                    </p>
                                </div>
                                
                                <div class="hidden sm:flex items-center justify-center w-10 h-10 rounded-full border border-white/10 group-hover:border-[--color-primary] group-hover:bg-[--color-primary]/10 transition-colors shrink-0">
                                    <svg class="w-4 h-4 text-gray-500 group-hover:text-[--color-primary] transition-all transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                    </svg>
                                </div>
                            </div>
                            
                            <div class="flex flex-wrap gap-2 mt-3">
                                {p.tags.map((tag) => (
                                    <span class="text-[9px] text-gray-400 font-mono uppercase border border-white/10 bg-white/5 px-2 py-1 rounded-md">
                                        {tag}
                                    </span>
                                ))}
                            </div>
                        </div>
                    </a>
                ))}
            </div>

        </div>
    </div>
</section>